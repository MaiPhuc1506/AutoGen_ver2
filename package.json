{
  "name": "auto-news-video",
  "version": "2.0.0",
  "description": "Auto-generate Vietnamese 9:16 short news videos from URL/txt \u2014 Claude Code skill + HyperFrames + LucyLab/ElevenLabs TTS",
  "main": "src/cli.ts",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "script": "tsx src/script/cli.ts",
    "ingest": "tsx src/ingest/cli.ts",
    "pipeline": "tsx src/cli.ts",
    "web": "tsx src/server.ts",
    "serve": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "rerender": "tsx rerender.ts",
    "captions:import": "tsx src/captions/import-cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "sfx:download": "tsx scripts/download-sfx.ts",
    "sfx:filter": "tsx scripts/filter-sfx.ts",
    "zerotts:setup": "bash scripts/setup-zerotts.sh"
  },
  "keywords": [
    "video",
    "tts",
    "news",
    "vietnamese",
    "tiktok",
    "shorts",
    "hyperframes",
    "claude-code",
    "lucylab",
    "elevenlabs"
  ],
  "author": "Cuongyd196",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cuongyd196/auto-video-gen.git"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "express": "^5.3.0",
    "gsap": "^3.14.2",
    "hyperframes": "^0.4.34",
    "p-limit": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nock": "^14.0.13",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
